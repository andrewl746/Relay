# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real keys.
#
# Get both values from: Supabase dashboard -> your project -> Settings -> API
#
# Firebase comparison: this is the same information as your firebaseConfig
# object (apiKey, authDomain, etc.) — just two values instead of six, and it's
# fine that both are public (NEXT_PUBLIC_): Supabase's row-level security is
# what actually protects data, the same job Firebase security rules do.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Maps (optional; pickup map falls back to a text card without it) ---
# console.cloud.google.com -> APIs & Services -> Library -> "Maps Embed API" ->
# Enable, then Credentials -> Create credentials -> API key.
# Restrict it to HTTP referrers (localhost:4287 and your deploy domain).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyCtyFj37MASi-yxjQ2cf27D77BeWBPbrJE
