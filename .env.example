# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real keys.
#
# Get both values from: Supabase dashboard -> your project -> Settings -> API
#
# Firebase comparison: this is the same information as your firebaseConfig
# object (apiKey, authDomain, etc.) — just two values instead of six, and it's
# fine that both are public (NEXT_PUBLIC_): Supabase's row-level security is
# what actually protects data, the same job Firebase security rules do.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Maps (optional; pickup map falls back to a text card without it) ---
# console.cloud.google.com -> APIs & Services -> Library -> "Maps Embed API" ->
# Enable, then Credentials -> Create credentials -> API key.
# Restrict it to HTTP referrers (localhost:4287 and your deploy domain).

# --- Snowflake Cortex (MATCH_PROVIDER=snowflake; omit it all for the offline stub) ---
# Account: Snowsight -> your name (bottom-left) -> Account -> Account Identifier,
#   written ORGNAME-ACCOUNTNAME (the URL /nakkqzo/wk53488 means nakkqzo-wk53488).
# PAT:     Settings -> Authentication -> Programmatic access tokens -> Generate.
#   A PAT also needs a network policy on the account or user. Without one every
#   call is 401 "Network policy is required" — the token is fine, the account
#   isn't. The token's ... menu has "Bypass requirement for network policy",
#   which is capped at 24 HOURS. For anything longer, create a real policy.
# Warehouse is required even for statements that touch no table.
# Model names go legacy and are then rejected outright (claude-3-5-sonnet,
#   claude-4-sonnet, mistral-large2 and openai-gpt-4.1 are all dead already).
MATCH_PROVIDER=stub
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_PAT=
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_EMBED_MODEL=snowflake-arctic-embed-m-v1.5
SNOWFLAKE_CHAT_MODEL=claude-sonnet-4-5

# --- Backboard.io ---
# app.backboard.io -> Settings -> API Keys -> Create Key.
# The free $5 credit covers Memory & RAG only; LLM chat is refused, so need
# extraction falls back to Cortex. See lib/providers/backboard.ts.
BACKBOARD_API_KEY=
